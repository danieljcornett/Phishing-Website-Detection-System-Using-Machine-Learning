import React, { useState } from 'react';

const PhishingDetector = () => {
  const [emailText, setEmailText] = useState('');
  const [privacyMode, setPrivacyMode] = useState(true);
  const [result, setResult] = useState(null);

  const handleAnalyze = async () => {
    const response = await fetch('http://localhost:8000/analyze', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        raw_email: emailText,
        privacy_mode: privacyMode
      })
    });
    const data = await response.json();
    setResult(data);
  };

  return (
    <div className="p-6 max-w-2xl mx-auto">
      <h2 className="text-2xl font-bold mb-4">Email Threat Analyzer</h2>
      
      <textarea 
        className="w-full h-48 p-3 border rounded mb-4"
        placeholder="Paste raw email headers and body here..."
        value={emailText}
        onChange={(e) => setEmailText(e.target.value)}
      />
      
      <div className="flex items-center mb-6">
        <input 
          type="checkbox" 
          id="privacyToggle"
          checked={privacyMode}
          onChange={(e) => setPrivacyMode(e.target.checked)}
          className="w-5 h-5 mr-3"
        />
        <label htmlFor="privacyToggle" className="font-semibold">
          Enable Zero-Retention Privacy Mode (Do not store observed data)
        </label>
      </div>
      
      <button 
        onClick={handleAnalyze}
        className="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700"
      >
        Analyze Email
      </button>

      {result && (
        <div className="mt-6 p-4 bg-gray-100 rounded">
          <p>Status: <strong>{result.is_phishing ? 'Phishing Detected' : 'Safe'}</strong></p>
          <p>Confidence: {result.confidence_score}</p>
        </div>
      )}
    </div>
  );
};

export default PhishingDetector;