{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "phishing_api": {
      "root": "phishing_api",
      "framework": "fastapi",
      "entrypoint": "main.py"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "phishing_api" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
